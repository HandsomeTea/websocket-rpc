name: build
on:
    workflow_dispatch:
    # push:
    #     branches: [develop]
jobs:
    build:
        runs-on: ubuntu-latest
        steps:
            - uses: actions/checkout@v4
            - uses: actions/setup-node@v4
              with:
                  node-version: "24.15.x"
                  registry-url: "https://registry.npmjs.org"
            - uses: pnpm/action-setup@v4
            - run: pnpm install
            - run: pnpm build
