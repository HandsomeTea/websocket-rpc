{
	"name": "@coco-sheng/websocket-rpc",
	"version": "1.2.0",
	"description": "简单易用的websocket-rpc服务，基于ws，遵循JSON-RPC 2.0协议",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc",
		"prepublishOnly": "npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"example": "tsx ./example/example.ts",
		"instance-server": "tsx ./multiple-instances/server.ts",
		"instance-client": "tsx ./multiple-instances/client.ts",
		"title": "./node_modules/.bin/doctoc README.md multiple-instances/README.md",
		"lint": "eslint . --fix",
		"preview-eslint": "npx @eslint/config-inspector",
		"commit": "./node_modules/cz-customizable/standalone.js",
		"upgrade": "./node_modules/.bin/npm-check -u",
		"husky-init": "husky init"
	},
	"directories": {
		"test": "test"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HandsomeTea/websocket-rpc.git"
	},
	"keywords": [
		"websocket"
	],
	"author": "HandsomeTea.coco@gmail.com",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/HandsomeTea/websocket-rpc/issues"
	},
	"homepage": "https://github.com/HandsomeTea/websocket-rpc#readme",
	"dependencies": {
		"log4js": "^6.9.1",
		"ws": "^8.21.1"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"cz-customizable": "^7.5.4",
		"doctoc": "^2.5.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-unused-imports": "^4.4.1",
		"express": "^5.2.1",
		"globals": "^17.8.0",
		"husky": "^9.1.7",
		"mongoose": "^8.24.2",
		"npm-check": "^6.0.1",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24.15.0"
	}
}
